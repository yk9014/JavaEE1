	<filter>
		<filter-name>authenticatefilter</filter-name>
		<filter-class>ttc.AuthenticateFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>authenticatefilter</filter-name>
		<url-pattern>/productinput</url-pattern>
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>FORWARD</dispatcher>
	</filter-mapping>

	<jsp-config>
	    <taglib>
	      <taglib-uri>http://www.tera-house.ac.jp</taglib-uri>
	      <taglib-location>/sample.tld</taglib-location>
	    </taglib>
	</jsp-config>

	<servlet>
		<servlet-name>productinput</servlet-name>
		<jsp-file>/productinput.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>productinput</servlet-name>
		<url-pattern>/productinput</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>orderlogin</servlet-name>
		<jsp-file>/orderlogin.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>orderlogin</servlet-name>
		<url-pattern>/orderlogin</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>authenticate</servlet-name>
		<servlet-class>ttc.AuthenticateServlet</servlet-class>
	</servlet>	
	<servlet-mapping>
		<servlet-name>authenticate</servlet-name>
		<url-pattern>/authenticate</url-pattern>
	</servlet-mapping>


  <servlet>
  	<servlet-name>inputservlet</servlet-name>
  	<servlet-class>InputServlet</servlet-class>
  </servlet>
  <servlet-mapping>
