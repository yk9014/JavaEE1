  </servlet>
  <servlet-mapping>
  	<servlet-name>result</servlet-name>
  	<url-pattern>/result</url-pattern>
  </servlet-mapping>

  <servlet>
  	<servlet-name>multiinput</servlet-name>
  	<servlet-class>MultiFormServlet</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>multiinput</servlet-name>
  	<url-pattern>/multiinput</url-pattern>
  </servlet-mapping>

  <servlet>
  	<servlet-name>mapresult</servlet-name>
  	<jsp-file>/mapresult.jsp</jsp-file>
  </servlet>
  <servlet-mapping>
  	<servlet-name>mapresult</servlet-name>
  	<url-pattern>/mapresult</url-pattern>
  </servlet-mapping>
	<servlet>
		<servlet-name>input</servlet-name>
		<jsp-file>/input.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>input</servlet-name>
		<url-pattern>/input</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>adduser</servlet-name>
		<servlet-class>AddUserServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>adduser</servlet-name>
		<url-pattern>/adduser</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>userslist</servlet-name>
		<jsp-file>/userslist.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>userslist</servlet-name>
		<url-pattern>/userslist</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>front</servlet-name>
		<servlet-class>FrontServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>front</servlet-name>
		<url-pattern>/front</url-pattern>
	</servlet-mapping>
	
	<!--ここからセッションがらみ-->
	<servlet>
		<servlet-name>GetCountServlet</servlet-name>
		<servlet-class>session.GetCountServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>GetCountServlet</servlet-name>
		<url-pattern>/getcountservlet</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>countshow</servlet-name>
		<jsp-file>/session/countshow.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>countshow</servlet-name>
		<url-pattern>/countshow</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>SessionStartServlet</servlet-name>
		<servlet-class>session.SessionStartServlet</servlet-class>
	</servlet>
    <servlet-mapping>
		<servlet-name>SessionStartServlet</servlet-name>
		<url-pattern>/sessionstart</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>sessionshow</servlet-name>
		<jsp-file>/session/sessionshow.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>sessionshow</servlet-name>
		<url-pattern>/sessionshow</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>SessionEndServlet</servlet-name>
		<servlet-class>session.SessionEndServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>SessionEndServlet</servlet-name>
		<url-pattern>/sessionend</url-pattern>
	</servlet-mapping>

    <session-config>
        <session-timeout>120</session-timeout>
    </session-config>

	<!--ここまでセッション-->



</web-app>